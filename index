            border: 1px solid var(--card-border);
            border-radius: 20px;
            color: var(--light);
            font-family: 'Inter', sans-serif;
            font-size: 0.95rem;
            transition: var(--transition);
        }

        .ai-input:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 2px rgba(79, 70, 229, 0.3);
        }

        .ai-send {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: var(--primary);
            border: none;
            color: white;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: var(--transition);
        }

        .ai-send:hover {
            background: var(--primary-dark);
            transform: scale(1.05);
        }

        .ai-quick-questions {
            margin-top: 15px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
        }

        .ai-quick-btn {
            padding: 8px 10px;
            background: rgba(0, 0, 0, 0.2);
            border: 1px solid var(--card-border);
            border-radius: 8px;
            color: var(--light);
            font-size: 0.8rem;
            cursor: pointer;
            text-align: center;
            transition: var(--);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .ai-quick-btn:hover {
            background: rgba(124, 58, 237, 极速3.0);
        }

        .ai-suggestions {
            margin-top: 10px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
        }

        .ai-suggestion {
            padding: 8px 10px;
            background: rgba(0, 0, 0, 0.2);
            border: 1px solid var(--card-border);
            border-radius: 8px;
            color: var(--light);
            font-size: 0.8rem;
            cursor: pointer;
            text-align: center;
            transition: var(--transition);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .ai-suggestion:hover {
            background: rgba(16, 185, 129, 0.3);
        }

        /* ======================
           PERMISSION REQUEST BUTTON
           ====================== */
        .permission-hint {
            display: none;
            align-items: center;
            justify-content: center;
            gap: 10px;
            padding: 12px 18px;
            border-radius: 12px;
            font-weight: 500;
            font-size: 0.92rem;
            line-height: 1.5;
            text-align: center;
            border: 1px solid var(--warning);
            background: rgba(245, 158, 11, 0.12);
            color: var(--warning);
            font-family: 'Inter', sans-serif;
            margin: 10px auto;
            max-width: 340px;
        }

        .permission-btn {
            display: none;
            align-items: center;
            justify-content: center;
            gap: 12px;
            padding: 16px 30px;
            border-radius: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: var(--transition);
            border: none;
            outline: none;
            font-size: 1.1rem;
            min-height: 55px;
            min-width: 250px;
            background: linear-gradient(to right, var(--warning), #f59e0b);
            color: white;
            box-shadow: 0 0 15px rgba(245, 158, 11, 0.6), 0 0 25px rgba(245, 158, 11, 0.4);
            animation: glow-pulse-permission 2s ease-in-out infinite;
            font-family: 'Inter', sans-serif;
            flex: 1;
            max-width: 300px;
            position: relative;
            overflow: hidden;
            z-index: 1;
            margin: 10px auto;
        }

        .permission-btn::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(45deg, var(--warning), #f59e0b, #d97706);
            opacity: 0;
            transition: opacity 0.4s ease;
            z-index: -1;
            pointer-events: none;
        }

        .permission-btn:hover {
            background: linear-gradient(to right, #d97706, #b45309);
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(245, 158, 11, 0.7), 0 0 40px rgba(245, 158, 11, 0.5);
            animation: none;
        }

        .permission-btn:hover::before {
            opacity: 1;
        }

        @keyframes glow-pulse-permission {
            0% {
                box-shadow: 0 0 10px rgba(245, 158, 11, 0.5), 0 0 20px rgba(245, 158, 11, 0.3);
            }
            50% {
                box-shadow: 0 0 20px rgba(245, 158, 11, 0.8), 0 0 35px rgba(245, 158, 11, 0.6);
            }
            100% {
                box-shadow: 0 0 10px rgba(245, 158, 11, 0.5), 0 0 20px rgba(245, 158, 11, 0.3);
            }
        }

