            // ======================

            /**
             * Loads saved state from localStorage
             */
            function loadState() {
                // Load theme preference
                const savedTheme = localStorage.getItem('theme');
                if (savedTheme) {
                    htmlElement.setAttribute('data-theme', savedTheme);
                    const icon = themeToggle.querySelector('i');
                    if (savedTheme === 'dark') {
                        icon.className = 'fas fa-sun';
                    } else if (savedTheme === 'light') {
                        icon.className = 'fas fa-moon';
                    } else {
                        icon.className = 'fas fa-adjust';
                    }
                }
                
                // Load selected language
                const savedLanguage = localStorage.getItem('selectedLanguage');
                if (savedLanguage && languageSelect) {
                    languageSelect.value = savedLanguage;
                    detectedLanguage.textContent = languageNames[savedLanguage] || savedLanguage;
                    applyScriptStyling(savedLanguage);
                }

                // Load Help & Support button position
                const savedHelpBtnPosition = localStorage.getItem('helpBtnPosition');
                if (savedHelpBtnPosition) {
                    const position = JSON.parse(savedHelpBtnPosition);
                    helpSupportBtn.style.left = position.left;
                    helpSupportBtn.style.top = position.top;
                    helpSupportBtn.style.bottom = 'auto';
                }

                // Load Help & Support panel position
                const savedHelpPanelPosition = localStorage.getItem('helpPanelPosition');
                if (savedHelpPanelPosition) {
                    const position = JSON.parse(savedHelpPanelPosition);
                    helpSupportPanel.style.left = position.left;
                    helpSupportPanel.style.top = position.top;
                    helpSupportPanel.style.bottom = 'auto';
                }

                // Load AI Assistant button position
                const savedAIBtnPosition = localStorage.getItem('aiBtnPosition');
                if (savedAIBtnPosition) {
                    const position = JSON.parse(savedAIBtnPosition);
                    aiAssistantBtn.style.left = position.left;
                    aiAssistantBtn.style.top = position.top;
                    aiAssistantBtn.style.bottom = 'auto';
                }

                // Load AI Assistant panel position
                const savedAIPanelPosition = localStorage.getItem('aiPanelPosition');
                if (savedAIPanelPosition) {
                    const position = JSON.parse(savedAIPanelPosition);
                    aiAssistantPanel.style.left = position.left;
                    aiAssistantPanel.style.top = position.top;
                    aiAssistantPanel.style.bottom = 'auto';
                }
            }

            // ======================
            // EVENT LISTENERS
            // ======================

            // Toggle recording
            if (toggleBtn) {
                toggleBtn.addEventListener('click', () => {
                    if (!checkInternetConnection()) {
                        showNotification('Internet connection required for speech recognition', true);
                        showOfflineMode();
                        return;
                    }
                    
                    if (isRecording) {
                        stopRecording();
                        return;
                    }
                    
                    beginRecording();
                });
            }

            // Language selection
            if (languageSelect) {
                languageSelect.addEventListener('change', () => {
                    if (recognition) recognition.lang = languageSelect.value;
                    detectedLanguage.textContent = languageNames[languageSelect.value] || languageSelect.value;
                    applyScriptStyling(languageSelect.value);

                    // Changing .lang on an already-active recognition session is
                    // ignored by most browsers until it's restarted, so the new
                    // language previously had no effect until you manually
                    // stopped and started again.
                    if (isRecording) {
                        stopRecording();
                        initSpeechRecognition();
                        recognition.start();
                        startDurationTimer(); // keep the clock running; startTime is untouched on purpose
                    }
                    
                    // Save selected language
                    localStorage.setItem('selectedLanguage', languageSelect.value);
                });
            }

            // Language search
            if (langSearch && languageList) {
                langSearch.addEventListener('input', () => {
                    const searchTerm = langSearch.value.toLowerCase();
                    languageList.innerHTML = '';
                    const filteredLanguages = Object.entries(languageNames).filter(([code, name]) =>
                        name.toLowerCase().includes(searchTerm) || code.toLowerCase().includes(searchTerm)
                    );
                    
                    filteredLanguages.forEach(([code, name]) => {
                        const item = document.createElement('div');
                        item.className = 'language-item';
                        item.textContent = name;
                        item.dataset.code = code;
                        item.addEventListener('click', () => {
                            languageSelect.value = code;
                            languageSelect.dispatchEvent(new Event('change'));
                            languageList.classList.remove('show');
                            langSearch.value = '';
                        });
                        languageList.appendChild(item);
                    });
                    
                    languageList.classList.toggle('show', filteredLanguages.length > 0);
                });
            }

            // Copy text
            if (copyBtn) {
                copyBtn.addEventListener('click', () => {
                    if (output.value) {
                        navigator.clipboard.writeText(output.value)
                            .then(() => {
                                showNotification('Text copied to clipboard!');
                            })
                            .catch(() => showNotification('Failed to copy text.', true));
                    } else {
                        showNotification('No text to copy.', true);
                    }
                });
            }

            // Save as text
            if (saveTextBtn) {
                saveTextBtn.addEventListener('click', () => {
                    if (output.value) {
                        const blob = new Blob([output.value], { type: 'text/plain' });
                        const url = URL.createObjectURL(blob);
                        const a = document.createElement('a');
                        a.href = url;
                        a.download = 'transcription.txt';
                        a.click();
                        URL.revokeObjectURL(url);
                        showNotification('Text file saved!');
                    } else {
                        showNotification('No text to save.', true);
                    }
                });
            }

            // Save as PDF
            let jsPDFLoadPromise = null;
            function loadJsPDF() {
                if (window.jspdf && window.jspdf.jsPDF) return Promise.resolve(window.jspdf.jsPDF);
                if (jsPDFLoadPromise) return jsPDFLoadPromise;
                // jsPDF's UMD build is not an ES module, so `import()` on it
                // silently fails to expose jsPDF — loading it as a classic
                // script (as UMD builds are meant to be loaded) is what
                // actually attaches window.jspdf.jsPDF.
                jsPDFLoadPromise = new Promise((resolve, reject) => {
                    const script = document.createElement('script');
                    script.src = 'https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js';
                    script.onload = () => {
                        if (window.jspdf && window.jspdf.jsPDF) resolve(window.jspdf.jsPDF);
                        else reject(new Error('jsPDF loaded but jsPDF class not found'));
                    };
                    script.onerror = () => reject(new Error('Failed to load jsPDF script'));
                    document.head.appendChild(script);
                });
                return jsPDFLoadPromise;
            }

            /**
             * Renders Arabic-script text (Urdu, Arabic, Persian, etc.) into a
             * PDF via canvas. jsPDF's built-in fonts (Helvetica/Times/Courier)
             * have no Arabic-script glyphs at all — text in those scripts
             * would previously export as a blank page. This draws the text
             * with the properly-loaded Noto Nastaliq Urdu font, right-to-left,
             * word-wrapped, and paginates automatically for long transcripts.
             */
            async function exportArabicScriptPDF(doc, text) {
                try {
                    await document.fonts.load('20px "Noto Nastaliq Urdu"');
                    await document.fonts.ready;
                } catch (e) {
                    console.warn('Nastaliq font load check failed, continuing anyway:', e);
                }

                const pageWidth = doc.internal.pageSize.getWidth();
                const pageHeight = doc.internal.pageSize.getHeight();
                const margin = 40;
                const usableWidth = pageWidth - margin * 2;
                const usableHeight = pageHeight - margin * 2;
                const fontSizePt = 18;
                const lineHeightPt = fontSizePt * 1.9;
                const scale = 2; // render at 2x for crisper text in the PDF

                const measureCanvas = document.createElement('canvas');
                const mctx = measureCanvas.getContext('2d');
                mctx.font = `${fontSizePt}px "Noto Nastaliq Urdu"`;

                // Manual word-wrap: canvas handles right-to-left shaping of a
                // single line automatically, but line-breaking itself has to
                // be done manually based on measured width.
                const words = text.split(/\s+/).filter(Boolean);
                const lines = [];
                let currentLine = '';
                for (const word of words) {
                    const testLine = currentLine ? currentLine + ' ' + word : word;
                    if (mctx.measureText(testLine).width > usableWidth && currentLine) {
                        lines.push(currentLine);
                        currentLine = word;
                    } else {
                        currentLine = testLine;
                    }
                }
                if (currentLine) lines.push(currentLine);
                if (lines.length === 0) lines.push('');

                const linesPerPage = Math.max(1, Math.floor(usableHeight / lineHeightPt));
                const totalPages = Math.max(1, Math.ceil(lines.length / linesPerPage));

                for (let p = 0; p < totalPages; p++) {
                    const pageLines = lines.slice(p * linesPerPage, (p + 1) * linesPerPage);

                    const canvas = document.createElement('canvas');
                    canvas.width = usableWidth * scale;
                    canvas.height = usableHeight * scale;
                    const ctx = canvas.getContext('2d');
                    ctx.scale(scale, scale);
                    ctx.fillStyle = '#ffffff';
                    ctx.fillRect(0, 0, usableWidth, usableHeight);
                    ctx.fillStyle = '#000000';
                    ctx.font = `${fontSizePt}px "Noto Nastaliq Urdu"`;
                    ctx.direction = 'rtl';
                    ctx.textAlign = 'right';
                    ctx.textBaseline = 'top';

                    pageLines.forEach((line, i) => {
                        ctx.fillText(line, usableWidth, i * lineHeightPt, usableWidth);
                    });

                    const imgData = canvas.toDataURL('image/png');
                    if (p > 0) doc.addPage();
                    doc.addImage(imgData, 'PNG', margin, margin, usableWidth, usableHeight);
                }
            }

            /**
             * Formats seconds as an SRT timestamp: HH:MM:SS,mmm
             */
            function formatSrtTime(totalSeconds) {
                const h = Math.floor(totalSeconds / 3600);
                const m = Math.floor((totalSeconds % 3600) / 60);
                const s = Math.floor(totalSeconds % 60);
                const ms = Math.round((totalSeconds - Math.floor(totalSeconds)) * 1000);
                const pad = (n, len = 2) => String(n).padStart(len, '0');
                return `${pad(h)}:${pad(m)}:${pad(s)},${pad(ms, 3)}`;
            }

            if (saveSrtBtn) {
                saveSrtBtn.addEventListener('click', () => {
                    if (!transcriptSegments.length) {
                        showNotification('No timestamped speech to export yet — record something first.', true);
                        return;
                    }

                    let srt = '';
                    transcriptSegments.forEach((seg, i) => {
                        const start = seg.timeSeconds;
                        const nextStart = transcriptSegments[i + 1] ? transcriptSegments[i + 1].timeSeconds : start + 3;
                        const end = Math.max(start + 1, nextStart - 0.1); // small gap so captions don't overlap
                        srt += `${i + 1}\n${formatSrtTime(start)} --> ${formatSrtTime(end)}\n${seg.text}\n\n`;
                    });

                    const blob = new Blob([srt], { type: 'text/plain;charset=utf-8' });
                    const url = URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = url;
                    a.download = 'transcription.srt';
                    document.body.appendChild(a);
                    a.click();
                    document.body.removeChild(a);
                    URL.revokeObjectURL(url);
                    showNotification('SRT caption file saved!');
                });
            }

            if (savePdfBtn) {
                savePdfBtn.addEventListener('click', () => {
                    if (!output.value) {
                        showNotification('No text to save.', true);
                        return;
                    }
                    const text = output.value;
                    const isArabicScript = /[\u0600-\u06FF]/.test(text);

                    loadJsPDF()
                        .then(async (jsPDF) => {
                            const doc = new jsPDF({ unit: 'pt', format: 'a4' });
                            if (isArabicScript) {
                                await exportArabicScriptPDF(doc, text);
                            } else {
                                doc.setFontSize(12);
                                const splitText = doc.splitTextToSize(text, doc.internal.pageSize.getWidth() - 80);
                                doc.text(splitText, 40, 50);
                            }
                            doc.save('transcription.pdf');
                            showNotification('PDF file saved!');
                        })
                        .catch((err) => {
                            console.error('PDF export failed:', err);
                            showNotification('Failed to create PDF. Check your internet connection.', true);
                        });
                });
            }

            // Clear text
            if (clearBtn) {
                clearBtn.addEventListener('click', showClearDialog);
            }

            // Clear confirmation
            if (clearBtnConfirm) {
                clearBtnConfirm.addEventListener('click', clearText);
            }
            
            // Cancel clear
            if (cancelClearBtn) {
                cancelClearBtn.addEventListener('click', hideClearDialog);
            }
            
            if (clearDialogClose) {
                clearDialogClose.addEventListener('click', hideClearDialog);
            }

            // Mobile menu toggle
            if (mobileMenuBtn && sidebar) {
                mobileMenuBtn.addEventListener('click', () => {
                    sidebar.classList.toggle('active');
                    mobileMenuBtn.innerHTML = sidebar.classList.contains('active') ? 
                        '<i class="fas fa-times"></i>' : '<i class="fas fa-bars"></i>';
                });
            }

            // Theme toggle
            if (themeToggle) {
                themeToggle.addEventListener('click', toggleTheme);
            }

            // Text input tracking for history
            if (output) {
                output.addEventListener('input', () => {
                    updateWordCount();
                    saveDraft();
                });
            }

            // Translation link
            if (translateLink) {
                translateLink.addEventListener('click', (e) => {
                    e.preventDefault();
                    showTranslationDialog();
                });
            }

            // Translation dialog close
            if (translationDialogClose) {
                translationDialogClose.addEventListener('click', hideTranslationDialog);
            }

            if (copyTranslationBtn) {
                copyTranslationBtn.addEventListener('click', async () => {
                    if (!translationResult.value) return;
                    try {
                        await navigator.clipboard.writeText(translationResult.value);
                        showNotification('Translation copied to clipboard.', false);
                    } catch (e) {
                        translationResult.select();
                        document.execCommand('copy');
                    }
                });
            }

            // Translation dialog confirm
            if (translationDialogConfirm) {
                translationDialogConfirm.addEventListener('click', translateText);
            }

            // Check connection button
            if (checkConnectionBtn) {
                checkConnectionBtn.addEventListener('click', () => {
                    if (checkInternetConnection()) {
                        hideOfflineMode();
                        initApp();
                    } else {
                        showNotification('Still offline. Please check your connection.', true);
                    }
                });
            }

            // AI Assistant button
            if (aiAssistantBtn) {
                aiAssistantBtn.addEventListener('click', toggleAIAssistant);
            }

            // AI Close button
            if (aiCloseBtn) {
                aiCloseBtn.addEventListener('click', toggleAIAssistant);
            }

            // AI Send button
            if (aiSendBtn) {
                aiSendBtn.addEventListener('click', () => {
                    if (aiInput.value.trim() !== '') {
                        processAIQuestion(aiInput.value);
                    }
                });
            }

            // AI Input enter key
            if (aiInput) {
                aiInput.addEventListener('keypress', (e) => {
                    if (e.key === 'Enter' && aiInput.value.trim() !== '') {
                        processAIQuestion(aiInput.value);
                    }
                });
            }

            // AI Quick questions
            aiQuickQuestions.forEach(btn => {
                btn.addEventListener('click', () => {
                    const question = btn.getAttribute('data-question');
                    processAIQuestion(question);
                });
            });

            // AI Suggestions
            aiSuggestions.forEach(btn => {
                btn.addEventListener('click', () => {
                    const action = btn.getAttribute('data-action');
                    processAIAction(action);
                });
            });

            // Help & Support button
            if (helpSupportBtn) {
                helpSupportBtn.addEventListener('click', toggleHelpSupport);
            }

            // Help Close button
            if (helpCloseBtn) {
                helpCloseBtn.addEventListener('click', toggleHelpSupport);
            }

            // Help accordion
            helpItems.forEach(item => {
                const question = item.querySelector('.help-question');
                question.addEventListener('click', () => {
                    toggleHelpItem(item);
                });
            });

            // Online/offline event listeners
            // Keyboard shortcut: Ctrl/Cmd + Space toggles recording. Guarded
            // against firing while typing anywhere (inputs, textareas,
            // contenteditable) so it never interferes with normal typing —
            // notably including the transcript box itself.
            document.addEventListener('keydown', (e) => {
                const tag = (e.target.tagName || '').toLowerCase();
                const isTyping = tag === 'input' || tag === 'textarea' || tag === 'select' || e.target.isContentEditable;
                if (isTyping) return;

                if (e.code === 'Space' && (e.ctrlKey || e.metaKey)) {
                    e.preventDefault();
                    if (isRecording) {
                        stopRecording();
                    } else {
                        beginRecording();
                    }
                }
            });

            window.addEventListener('online', () => {
                hideOfflineMode();
                showNotification('Internet connection restored!');
            });

            window.addEventListener('offline', () => {
                showOfflineMode();
                showNotification('You are now offline. Some features may not work.', true);
            });

            // ======================
            // INITIALIZATION
            // ======================

            // Initialize theme
            initTheme();

            // Load saved state
            loadState();

            // Initialize speech recognition
            initSpeechRecognition();

            // Initial stats update
            updateStats();

            // Initial word count
            updateWordCount();

            // Offer to restore any auto-saved draft from a previous session
            restoreDraftIfAny();

            /**
             * Applies right-to-left / Nastaliq styling to the transcript box
             * for Urdu, Arabic, and other Arabic-script languages.
             */
            function applyScriptStyling(langCode) {
                const arabicScriptLangs = ['ur-PK', 'ar-SA', 'ar-EG', 'ar-AE', 'ar-JO', 'ar-DZ', 'ar-MA', 'ar-IQ', 'ar-KW', 'ar-LB', 'fa-IR', 'ps-AF', 'ug-CN'];
                output.classList.toggle('urdu-script', arabicScriptLangs.includes(langCode));
            }

            // Initial language setup
            if (languageSelect && detectedLanguage) {
                detectedLanguage.textContent = languageNames[languageSelect.value] || languageSelect.value;
                applyScriptStyling(languageSelect.value);
            }

            // Keep the "language count" badge honest — it previously said
            // "200+" as a hardcoded, inflated number regardless of how many
            // languages were actually in the list.
            const langCountEl = document.getElementById('langCount');
            if (langCountEl && languageSelect) {
                const realCount = languageSelect.querySelectorAll('option').length;
                langCountEl.textContent = realCount + '+';
            }

            // Check browser compatibility
            checkBrowserCompatibility();

            // Optimize for mobile
            optimizeForMobile();

            // Check connection speed
            checkConnectionSpeed();
        }
    </script>
</body>
</html>
