            // ======================
            // DRAFT AUTO-SAVE
            // ======================

            const DRAFT_KEY = 'smartvoice_draft_transcript';

            /**
             * Saves the current transcript to localStorage so it survives an
             * accidental tab close or crash. Previously nothing but small UI
             * preferences (theme, button positions) were saved — the actual
             * transcribed text, which is the entire point of the app, wasn't
             * protected at all.
             */
            function saveDraft() {
                try {
                    if (output.value.trim()) {
                        localStorage.setItem(DRAFT_KEY, output.value);
                    } else {
                        localStorage.removeItem(DRAFT_KEY);
                    }
                } catch (e) {
                    // localStorage can throw in private/incognito modes when full — non-fatal
                    console.warn('Could not save draft:', e);
                }
            }

            function clearDraft() {
                try { localStorage.removeItem(DRAFT_KEY); } catch (e) {}
            }

            /**
             * Offers to restore a previously auto-saved draft on page load.
             */
            function restoreDraftIfAny() {
                let saved = null;
                try { saved = localStorage.getItem(DRAFT_KEY); } catch (e) {}
                if (!saved || !saved.trim()) return;

                const wantsRestore = confirm(
                    'A previous unsaved transcript was found (from before the page closed or reloaded). Restore it?'
                );
                if (wantsRestore) {
                    output.value = saved;
                    transcript = saved;
                    updateWordCount();
                    showNotification('Previous transcript restored.', false);
                } else {
                    clearDraft();
                }
            }

