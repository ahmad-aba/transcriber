            // ======================
            // VOICE PUNCTUATION COMMANDS
            // ======================

            // Maps spoken punctuation words (English + Urdu) to real symbols.
            const PUNCTUATION_COMMANDS = {
                'comma': ',', 'کوما': '،',
                'full stop': '.', 'period': '.', 'فل اسٹاپ': '۔', 'ختم جملہ': '۔',
                'question mark': '?', 'سوالیہ نشان': '؟',
                'exclamation mark': '!', 'exclamation point': '!', 'فجائیہ نشان': '!',
                'new line': '\n', 'نئی سطر': '\n',
                'new paragraph': '\n\n', 'نیا پیراگراف': '\n\n',
                'colon': ':', 'رابطہ نشان': ':',
                'semicolon': ';',
                'dash': ' - ', 'hyphen': '-'
            };

            // Multi-word commands must be checked before single-word ones
            // (e.g. "full stop" must be matched before a lone "full"/"stop").
            const PUNCTUATION_PHRASES = Object.keys(PUNCTUATION_COMMANDS).sort((a, b) => b.length - a.length);

            /**
             * Replaces spoken punctuation commands with real punctuation
             * marks, applied to each finalized chunk of speech as it arrives.
             */
            function applyVoicePunctuation(text) {
                let result = text;
                for (const phrase of PUNCTUATION_PHRASES) {
                    const symbol = PUNCTUATION_COMMANDS[phrase];
                    // \b only recognizes Latin word characters in JS regex,
                    // so Urdu phrases are matched via surrounding whitespace
                    // instead of a real word boundary.
                    const isLatin = /^[a-z\s]+$/i.test(phrase);
                    if (isLatin) {
                        result = result.replace(new RegExp(`\\b${phrase}\\b`, 'gi'), symbol);
                    } else {
                        result = result.replace(new RegExp(`(^|\\s)${phrase}(?=\\s|$)`, 'g'), (m, pre) => pre + symbol);
                    }
                }
                return result.replace(/ {2,}/g, ' ');
            }

            // ======================
            // SPEECH RECOGNITION
            // ======================

            /**
             * Initializes speech recognition
             */
            function initSpeechRecognition() {
                if ('webkitSpeechRecognition' in window || 'SpeechRecognition' in window) {
                    recognition = new (window.SpeechRecognition || window.webkitSpeechRecognition)();
                    
                    recognition.lang = languageSelect.value;
                    detectedLanguage.textContent = languageNames[languageSelect.value] || languageSelect.value;
                    
                    recognition.interimResults = true;
                    recognition.continuous = true;
                    
                    recognition.onstart = () => {
                        isRecording = true;
                        toggleBtn.classList.add('active');
                        toggleBtn.innerHTML = '<i class="fas fa-square"></i> Stop Recording';
                        statusValue.textContent = 'Recording...';
                        statusProgress.classList.add('recording-active');
                        confidenceProgress.classList.add('recording-active');
                        waveAnimation.style.display = 'flex';
                        
                        // Reset first recording attempt flag
                        firstRecordingAttempt = false;
                        
                        // Hide permission hint if it was shown
                        permissionHint.style.display = 'none';
                    };
                    
                    recognition.onresult = (event) => {
                        let interimTranscript = '';
                        for (let i = event.resultIndex; i < event.results.length; i++) {
                            const result = event.results[i];
                            if (result.isFinal) {
                                const rawChunk = result[0].transcript;
                                const punctuatedChunk = applyVoicePunctuation(rawChunk);
                                transcript += punctuatedChunk + ' ';
                                output.value = transcript;

                                // Record for SRT export — time is relative to
                                // when this recording session actually began.
                                const elapsedSeconds = startTime ? (Date.now() - startTime) / 1000 : 0;
                                transcriptSegments.push({ timeSeconds: elapsedSeconds, text: punctuatedChunk.trim() });

                                transcriptionCounter++;
                                const rawConfidence = result[0].confidence;
                                const confidence = (typeof rawConfidence === 'number' && !isNaN(rawConfidence) && rawConfidence > 0)
                                    ? rawConfidence * 100
                                    : 90; // sensible fallback when the browser doesn't report confidence
                                totalAccuracy += confidence;
                                confidenceValue.textContent = confidence.toFixed(1) + '%';
                                confidenceProgress.style.width = `${confidence}%`;
                                confidenceProgress.setAttribute('data-value', confidence.toFixed(1) + '%');
                                updateWordCount();
                                updateStats();
                                saveDraft();
                            } else {
                                interimTranscript += result[0].transcript;
                            }
                        }
                        output.value = transcript + interimTranscript;
                    };
                    
                    recognition.onend = () => {
                        if (isRecording) {
                            // Auto-restart for subsequent stops
                            setTimeout(() => {
                                if (isRecording) {
                                    recognition.start();
                                }
                            }, 100);
                        } else {
                            stopRecording();
                        }
                    };
                    
                    recognition.onerror = (event) => {
                        console.error('Speech recognition error:', event.error);

                        // "no-speech" and "aborted" fire constantly during normal
                        // pauses in continuous listening — they are NOT failures.
                        // Previously every single one of these stopped recording
                        // entirely, so transcription would silently die after the
                        // first pause in speech.
                        if (event.error === 'no-speech' || event.error === 'aborted') {
                            return;
                        }

                        if (event.error === 'not-allowed' || event.error === 'service-not-allowed') {
                            microphonePermissionGranted = false;
                            permissionHint.textContent = 'Microphone is blocked for this site. Tap the 🔒 lock icon next to the address bar → Permissions → Microphone → Allow, then try again.';
                            permissionHint.style.display = 'flex';
                            showNotification('Microphone access denied.', true);
                            stopRecording();
                        } else if (event.error === 'network') {
                            showNotification('Network error — check your internet connection.', true);
                            // Let onend's auto-restart retry rather than killing
                            // the whole session over a transient network blip.
                        } else {
                            showNotification('Error in speech recognition: ' + event.error, true);
                            stopRecording();
                        }
                    };
                } else {
                    showNotification('Speech recognition not supported in this browser.', true);
                    toggleBtn.disabled = true;
                    toggleBtn.innerHTML = '<i class="fas fa-microphone-slash"></i> Not Supported';
                }
            }

            /**
             * Stops speech recognition
             */
            function stopRecording() {
                if (recognition && isRecording) {
                    isRecording = false;
                    recognition.stop();
                    toggleBtn.classList.remove('active');
                    toggleBtn.innerHTML = '<i class="fas fa-microphone"></i> Start Recording';
                    statusValue.textContent = 'Ready';
                    statusProgress.classList.remove('recording-active');
                    confidenceProgress.classList.remove('recording-active');
                    waveAnimation.style.display = 'none';
                    clearInterval(durationInterval);
                    updateStats();
                }
            }

            /**
             * Enhanced browser compatibility check
             */
            function checkBrowserCompatibility() {
                const isChrome = !!window.chrome && (!!window.chrome.webstore || !!window.chrome.runtime);
                const isEdge = navigator.userAgent.includes('Edg/');
                const isFirefox = navigator.userAgent.includes('Firefox');
                const isSafari = /^((?!chrome|android).)*safari/i.test(navigator.userAgent);
                
                if (!isChrome && !isEdge) {
                    showNotification('For optimal performance, we recommend using Chrome or Edge browser', false);
                }
                
                // Safari specific fixes
                if (isSafari) {
                    document.querySelectorAll('.card').forEach(card => {
                        card.style.backdropFilter = 'none'; // Safari has performance issues with backdrop-filter
                    });
                }
                
                // Firefox specific fixes
                if (isFirefox) {
                    document.documentElement.style.scrollBehavior = 'auto'; // Firefox sometimes has issues with smooth scrolling
                }
            }

