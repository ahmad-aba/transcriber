            /**
             * Translates text using Google's free public translation endpoint
             * and shows the result right inside the app. Previously this only
             * opened a new browser tab with the text pre-filled — functional,
             * but it took people out of the app for something that should be
             * instant. Falls back to the old "open in new tab" behavior if
             * the request fails for any reason (e.g. blocked by network).
             */
            async function translateText() {
                const textToTranslate = output.value.trim();
                const targetLanguage = translationTarget.value;

                if (!textToTranslate) {
                    showNotification('No text to translate.', true);
                    return;
                }

                const confirmBtn = translationDialogConfirm;
                const originalLabel = confirmBtn.textContent;
                confirmBtn.textContent = 'Translating…';
                confirmBtn.disabled = true;

                try {
                    const url = `https://translate.googleapis.com/translate_a/single?client=gtx&sl=auto&tl=${encodeURIComponent(targetLanguage)}&dt=t&q=${encodeURIComponent(textToTranslate)}`;
                    const response = await fetch(url);
                    if (!response.ok) throw new Error('Translation request failed');
                    const data = await response.json();
                    // Response shape: [[[translatedChunk, originalChunk, ...], ...], ...]
                    const translated = data[0].map(chunk => chunk[0]).join('');

                    translationResult.value = translated;
                    translationResultWrap.style.display = 'block';
                    showNotification('Translated successfully.', false);
                } catch (error) {
                    console.error('In-app translation failed, falling back to Google Translate tab:', error);
                    const translateUrl = `https://translate.google.com/?sl=auto&tl=${targetLanguage}&text=${encodeURIComponent(textToTranslate)}&op=translate`;
                    window.open(translateUrl, '_blank');
                    showNotification('Could not translate in-app — opened Google Translate in a new tab instead.', true);
                } finally {
                    confirmBtn.textContent = originalLabel;
                    confirmBtn.disabled = false;
                }
            }

