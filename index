            transition: max-height 0.3s ease;
            background: rgba(0, 0, 0, 0.1);
        }

        .help-item.active .help-answer {
            max-height: 200px;
            padding: 15px;
        }

        .help-item.active .help-question i {
            transform: rotate(180deg);
        }

        /* ======================
           AI ASSISTANT STYLES - ENHANCED
           ====================== */
        .ai-assistant {
            position: fixed;
            bottom: 230px;
            left: 20px;
            width: 60px;
            height: 60px;
            background: var(--secondary);
