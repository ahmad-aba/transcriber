            /**
             * Summarizes text using local method
             * @param {string} text - Text to summarize
             */
            function summarizeText(text) {
                // Simple text summarization algorithm
                const sentences = text.split('. ');
                let summary = '';
                
                // Extract first 3 sentences or less if text is short
                const maxSentences = Math.min(3, sentences.length);
                for (let i = 0; i < maxSentences; i++) {
                    if (sentences[i].trim().length > 0) {
                        summary += sentences[i] + '. ';
                    }
                }
                
                hideTypingIndicator();
                addAIMessage(`Here's a summary of your text:\n\n${summary}`, 'bot');
            }

            /**
             * Corrects grammar using local method
             * @param {string} text - Text to correct
             */
            function correctGrammar(text) {
                // This only handles basic English capitalization/contractions
                // — it has no ability to correct Urdu or other Arabic-script
                // text. Rather than silently doing nothing while still
                // claiming success, tell the person plainly.
                if (/[\u0600-\u06FF]/.test(text)) {
                    hideTypingIndicator();
                    addAIMessage("This basic grammar tool only supports English text right now — it can't check Urdu/Arabic grammar yet.", 'bot');
                    return;
                }

                // Simple grammar correction (this is a very basic example)
                let correctedText = text
                    .replace(/\bi\b/g, 'I') // Replace 'i' with 'I'
                    .replace(/\bdon't\b/g, 'do not') // Expand contractions
                    .replace(/\bcan't\b/g, 'cannot')
                    .replace(/\bit's\b/g, 'it is')
                    .replace(/\bwon't\b/g, 'will not');
                
                hideTypingIndicator();
                addAIMessage(`I've corrected some basic grammar in your text:\n\n${correctedText}`, 'bot');
                
                // Update the output with corrected text
                output.value = correctedText;
                showNotification('Grammar corrections applied!');
            }

