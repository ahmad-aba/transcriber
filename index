             * @param {string} question - User's question
             */
            function processAIQuestion(question) {
                addAIMessage(question, 'user');
                showTypingIndicator();
                
                // Clear input
                aiInput.value = '';
                
                // Use local knowledge base for responses
                setTimeout(() => {
                    hideTypingIndicator();
                    fallbackAIResponse(question);
                }, 1000);
            }

            /**
             * Fallback AI response using local knowledge base
             * @param {string} question - User's question
             */
            function fallbackAIResponse(question) {
                const lowerQuestion = question.toLowerCase();
                let response = aiKnowledgeBase.default;
                
                if (lowerQuestion.includes('speech recognition') || 
                          lowerQuestion.includes('transcription') || 
                          lowerQuestion.includes('how it works')) {
                    response = aiKnowledgeBase["speech recognition"];
                } else if (lowerQuestion.includes('language') || 
                          lowerQuestion.includes('support')) {
                    response = aiKnowledgeBase.languages;
                } else if (lowerQuestion.includes('accuracy') || 
                          lowerQuestion.includes('improve') || 
                          lowerQuestion.includes('better')) {
                    response = aiKnowledgeBase.accuracy;
                }
                
                // Simulate typing effect for more natural interaction
                simulateTypingEffect(response.content);
            }

            /**
             * Simulates typing effect for AI responses
             * @param {string} text - Text to display with typing effect
             */
            function simulateTypingEffect(text) {
                const responseElement = document.createElement('div');
                responseElement.className = 'ai-message ai-bot';
                aiConversation.appendChild(responseElement);
                
                let i = 0;
                const typingInterval = setInterval(() => {
                    if (i < text.length) {
                        responseElement.textContent += text.charAt(i);
                        i++;
                        aiConversation.scrollTop = aiConversation.scrollHeight;
                    } else {
                        clearInterval(typingInterval);
                    }
                }, 20);
            }

