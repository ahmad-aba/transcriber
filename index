        .help-close {
            background: none;
            border: none;
            color: var(--light-gray);
            font-size: 1.2rem;
            cursor: pointer;
        }

        .help-content {
            flex: 1;
            overflow-y: auto;
            margin-bottom: 15px;
            padding: 10px;
            background: rgba(0, 0, 0, 0.2);
            border-radius: 10px;
            max-height: 300px;
        }

        .help-accordion {
            margin-top: 15px;
        }

        .help-item {
            margin-bottom: 10px;
            border: 1px solid var(--card-border);
            border-radius: 10px;
            overflow: hidden;
            background: rgba(0, 0, 0, 0.1);
        }

        .help-question {
            padding: 15px;
            background: rgba(0, 0, 0, 0.2);
            cursor: pointer;
            display: flex;
            justify-content: space-between;
            align-items: center;
