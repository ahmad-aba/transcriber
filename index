            /**
             * Optimizes performance for mobile devices
             */
            function optimizeForMobile() {
                if (!isMobile) return;
                
                // Reduce animations and effects for better mobile performance
                document.documentElement.style.scrollBehavior = 'auto';
                
                // Simplify some UI elements
                document.querySelectorAll('.card').forEach(card => {
                    card.style.backdropFilter = 'none';
                    card.style.boxShadow = '0 4px 15px rgba(0, 0, 0, 0.1)';
                });
                
                // Disable some hover effects
                document.querySelectorAll('.action-btn, .stat-item, .efficiency-card').forEach(el => {
                    el.style.transform = 'none';
                    el.style.boxShadow = 'none';
                });
                
                // Add mobile-specific event listeners to prevent default behaviors
                document.addEventListener('touchmove', function(e) {
                    // Prevent default on the textarea to avoid page scrolling issues
                    if (e.target === output) {
                        e.preventDefault();
                    }
                }, { passive: false });
            }

            // ======================
            // LOW CONNECTION HANDLING
            // ======================

            /**
             * Checks connection speed and adjusts functionality
             */
            function checkConnectionSpeed() {
                // Only check if we're online
                if (!navigator.onLine) return;
                
                // Use navigator.connection if available
                if (navigator.connection) {
                    const connection = navigator.connection;
                    const effectiveType = connection.effectiveType;
                    const downlink = connection.downlink;
                    
                    // Adjust functionality based on connection speed
                    if (effectiveType === 'slow-2g' || effectiveType === '2g' || downlink < 1) {
                        showNotification('Slow connection detected. Some features may be limited.', true);
                        
                        // Reduce data usage
                        if (recognition) {
                            recognition.interimResults = false;
                        }
                    }
                }
            }

