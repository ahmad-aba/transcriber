            // ======================

            /**
             * Starts recording. recognition.start() is called immediately and
             * synchronously in direct response to the click — NOT after an
             * awaited permission check — because any async gap before start()
             * can cause strict/mobile browsers to no longer treat the call as
             * originating from a real user gesture, silently failing with
             * "not-allowed" even on a first-ever, totally fresh click. This
             * was the actual cause of "clicking Allow does nothing": Chrome's
             * native permission popup was never getting triggered at all.
             */
            function beginRecording() {
                permissionHint.style.display = 'none';
                initSpeechRecognition();
                if (!recognition) return;
                startTime = Date.now();
                startDurationTimer();
                try {
                    recognition.start();
                    firstRecordingAttempt = false;
                } catch (e) {
                    console.error('recognition.start() failed:', e);
                }
            }

