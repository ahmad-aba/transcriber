            function updateStats() {
                // Transcription count
                if (transcriptionStat) transcriptionStat.textContent = transcriptionCounter;
                
                // Accuracy stats
                if (accuracyStat && transcriptionCounter > 0) {
                    const accuracy = totalAccuracy / transcriptionCounter;
                    accuracyStat.textContent = accuracy.toFixed(1) + '%';
                    
