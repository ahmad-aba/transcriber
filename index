                    }
                }
                
                // Word count based stats
                if (wordCountValue > 0) {
                    // Recompute directly from the current total word count
                    // instead of repeatedly adding the full total again on
                    // every update (which made this number balloon far past
                    // reality over the course of a session).
                    savedMinutes = wordCountValue / 100;
                    
                    // Time saved
                    if (timeSaved) {
                        timeSaved.textContent = savedMinutes.toFixed(1) + ' min';
                        if (timeSavedProgress) {
