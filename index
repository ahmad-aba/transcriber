        .help-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
            padding-bottom: 10px;
            border-bottom: 1px solid var(--card-border);
            cursor: move; /* Indicate it's draggable */
        }

        .help-title {
            font-size: 1.2rem;
            font-weight: 600;
            color: var(--warning);
            display: flex;
            align-items: center;
            gap: 10px;
            user-select: none;
            flex: 1;
